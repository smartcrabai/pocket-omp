{
  "expo": {
    "name": "Pocket OMP",
    "slug": "pocket-omp",
    "scheme": "pocket-omp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketomp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the one-time Pocket OMP Host pairing code."
      }
    },
    "android": {
      "package": "com.pocketomp.mobile",
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Scan a one-time Host pairing code." }],
      ["expo-notifications", { "defaultChannel": "session-events" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
