{
  "name": "pocket-omp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/control-api",
    "integration"
  ],
  "scripts": {
    "dev": "bun run --cwd services/control-api dev",
    "deploy": "bun run --cwd services/control-api deploy",
    "deploy:review": "bun run --cwd services/control-api deploy:review",
    "deploy:check": "bun run --cwd services/control-api deploy:check",
    "gen": "buf generate && biome format --write packages/proto",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "bun run --parallel --filter '*' typecheck",
    "test:ts": "bun test packages services apps --pass-with-no-tests",
    "test:workers": "bun run --cwd services/control-api test",
    "test:integration": "bun test integration",
    "architecture": "bun scripts/check-architecture.ts",
    "check": "bun run gen && bun run format:check && bun run lint && buf lint && bun run architecture && bun run typecheck && bun run test:ts && bun run test:workers"
  },
  "catalog": {
    "@biomejs/biome": "2.5.5",
    "@bufbuild/protobuf": "2.13.0",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@oh-my-pi/pi-coding-agent": "17.1.5",
    "@oh-my-pi/pi-agent-core": "17.1.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@types/bun": "1.3.14",
    "jose": "6.2.4",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "npm:@typescript/native-preview@7.0.0-dev.20260707.2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/bun": "catalog:",
    "@types/node": "^26.1.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
