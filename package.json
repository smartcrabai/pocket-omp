{
  "name": "pocket-omp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/agent-runtime",
    "services/control-*",
    "services/admin-api",
    "services/review-host",
    "integration"
  ],
  "scripts": {
    "gen": "buf generate && biome format --write packages/proto",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "bun run --parallel --filter '*' typecheck",
    "test:ts": "bun test packages services apps --pass-with-no-tests",
    "test:rust": "cargo test --workspace",
    "test:rust:unit": "cargo test --workspace --lib && cargo test -p relay-domain --test e2ee_vector && cargo test -p relay-testkit --test application_contract && cargo test -p relay-adapters --test ticket_verifier",
    "test:integration": "cargo test -p relay-adapters --test postgres_contract --test redis_wakeup --test standby_replication && bun test integration",
    "architecture": "bun scripts/check-architecture.ts",
    "check": "just check"
  },
  "catalog": {
    "@biomejs/biome": "2.5.5",
    "@bufbuild/protobuf": "2.13.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@oh-my-pi/pi-coding-agent": "17.1.5",
    "@oh-my-pi/pi-agent-core": "17.1.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@types/bun": "1.3.14",
    "jose": "6.2.4",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "npm:@typescript/native-preview@7.0.0-dev.20260707.2"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
